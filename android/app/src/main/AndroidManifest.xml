<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/AppTheme">

        <activity
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode|navigation|density"
            android:name=".MainActivity"
            android:label="@string/title_activity_main"
            android:theme="@style/AppTheme.NoActionBarLaunch"
            android:launchMode="singleTask"
            android:exported="true">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

        </activity>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths"></meta-data>
        </provider>

        <!-- CONFIG A (test). For production: pk_live, stripe_account=acct_1TPQ8wLUuImmvva6, google_pay_is_testing=false. Phase 4: move to manifestPlaceholders. -->
        <meta-data android:name="com.google.android.gms.wallet.api.enabled" android:value="true" />
        <meta-data android:name="com.getcapacitor.community.stripe.enable_google_pay" android:value="true" />
        <meta-data android:name="com.getcapacitor.community.stripe.publishable_key" android:value="pk_test_51TJzAWLDgLXBOes55MhN1fBWhZzWSz480AyvzJaYb7nw1yJP1OBY1unmq3KbC6lKu8o8c1eOMWhIFBEKhDr1fr8u0000jwDkHe" />
        <meta-data android:name="com.getcapacitor.community.stripe.country_code" android:value="US" />
        <meta-data android:name="com.getcapacitor.community.stripe.merchant_display_name" android:value="Test Pizza" />
        <meta-data android:name="com.getcapacitor.community.stripe.email_address_required" android:value="true" />
        <meta-data android:name="com.getcapacitor.community.stripe.phone_number_required" android:value="true" />
        <meta-data android:name="com.getcapacitor.community.stripe.billing_address_required" android:value="true" />
        <meta-data android:name="com.getcapacitor.community.stripe.billing_address_format" android:value="Min" />
