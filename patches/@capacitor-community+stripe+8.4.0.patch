+
+    // ---- DirectBite: PaymentMethod-only Google Pay -------------------------
+    // All state below is touched only on the main thread (ready/result
+    // callbacks already arrive there; plugin-method bodies are posted to it).
+    var googlePayPmLauncher: GooglePayPaymentMethodLauncher? = null
+    private var pmReady: Boolean? = null
+    private val pendingPmReadyCalls = mutableListOf<PluginCall>()
+    private val mainHandler = Handler(Looper.getMainLooper())
+
+    fun onPmReady(isReady: Boolean) {
+        pmReady = isReady
+        val calls = pendingPmReadyCalls.toList()
+        pendingPmReadyCalls.clear()
+        calls.forEach { it.resolve(JSObject().put("available", isReady)) }
+    }
+
+    fun isGooglePayPaymentMethodAvailable(call: PluginCall) {
+        mainHandler.post {
+            val ready = pmReady
+            if (googlePayPmLauncher == null) {
+                call.resolve(JSObject().put("available", false))
+            } else if (ready != null) {
+                call.resolve(JSObject().put("available", ready))
+            } else {
+                pendingPmReadyCalls.add(call)
+                mainHandler.postDelayed({
+                    if (pendingPmReadyCalls.remove(call)) {
+                        call.resolve(JSObject().put("available", false))
+                    }
+                }, 5000)
+            }
+        }
+    }
+
+    fun presentGooglePayPaymentMethod(call: PluginCall, bridge: Bridge) {
+        val currency = call.getString("currency", "USD")!!
+        val amount = (call.data.opt("amount") as? Number)?.toLong()
+        mainHandler.post {
+            val launcher = googlePayPmLauncher
+            when {
+                amount == null -> rejectAndRelease(call, bridge, "amount (Long, cents) is required")
+                launcher == null -> rejectAndRelease(call, bridge, "Google Pay is not configured")
+                pmReady != true -> rejectAndRelease(call, bridge, "Google Pay is not available")
+                else -> try {
+                    launcher.present(currency, amount)
+                } catch (e: Exception) {
+                    rejectAndRelease(call, bridge, e.localizedMessage ?: "present failed")
+                }
+            }
+        }
+    }
+
+    private fun rejectAndRelease(call: PluginCall, bridge: Bridge, msg: String) {
+        call.reject(msg)
+        bridge.releaseCall(call)
+    }
+
+    fun onPmResult(bridge: Bridge, callbackId: String?, result: GooglePayPaymentMethodLauncher.Result) {
+        val call = bridge.getSavedCall(callbackId) ?: return
+        val ret = JSObject()
+        when (result) {
+            is GooglePayPaymentMethodLauncher.Result.Completed -> {
+                val pm = result.paymentMethod
+                ret.put("status", "completed")
+                ret.put("paymentMethodId", pm.id)
+                ret.put("name", pm.billingDetails?.name)
+                ret.put("email", pm.billingDetails?.email)
+                ret.put("phone", pm.billingDetails?.phone)
+            }
+            is GooglePayPaymentMethodLauncher.Result.Canceled -> ret.put("status", "canceled")
+            is GooglePayPaymentMethodLauncher.Result.Failed -> {
+                ret.put("status", "failed")
+                ret.put("error", result.error.localizedMessage)
+            }
+        }
+        call.resolve(ret)
+        bridge.releaseCall(call)
+    }
 }
